# ===============================================
# College Complaint Management System - Backend Config
# ===============================================

# Server Port
PORT=5000

# MongoDB Atlas or Local Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/college_complaints?retryWrites=true&w=majority

# JWT Secret Key (Generate a secure 32+ character random string)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Node Environment (development | production | test)
NODE_ENV=development
